{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["gcc", "libc6-dev", "pkg-config", "libheif-dev"],
  "steps": {
    "build": {
      "commands": [
        { "cmd": "env CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o out ./cmd/tt-scrap" },
        { "cmd": "test -x out" }
      ]
    }
  },
  "deploy": {
    "aptPackages": ["...", "ca-certificates", "libheif1", "libheif-plugin-libde265", "libheif-plugin-dav1d"]
  }
}
