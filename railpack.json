{
  "$schema": "https://schema.railpack.com",
  "provider": "golang",
  "packages": {
    "go": "1.27.2"
  },
  "buildAptPackages": [
    "gcc",
    "libc6-dev",
    "pkg-config",
    "libheif-dev"
  ],
  "steps": {
    "build": {
      "commands": [
        "CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o out ./cmd/tt-scrap"
      ]
    }
  },
  "deploy": {
    "startCommand": "./out",
    "aptPackages": [
      "ca-certificates",
      "ffmpeg",
      "libheif1",
      "libheif-plugin-libde265",
      "libheif-plugin-dav1d"
    ]
  }
}
