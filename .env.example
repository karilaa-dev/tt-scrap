# API authentication (generate with: openssl rand -hex 32)
TT_SCRAP_API_KEY=replace-with-at-least-16-characters

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CACHE_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Dedicated ephemeral Redis
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0
CACHE_TTL_SECONDS=600

# Instagram RapidAPI
RAPIDAPI_KEY=replace-with-rapidapi-key
INSTAGRAM_MAX_ATTEMPTS=3
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=2
INSTAGRAM_RETRY_DELAY_SECONDS=0.5

# TikTok authentication and proxy rotation
YTDLP_COOKIES=/run/secrets/cookies.txt
PROXY_FILE=/run/secrets/proxies.txt
PROXY_DATA_ONLY=false
PROXY_INCLUDE_HOST=false

# Three independent retry stages
URL_RESOLVE_MAX_RETRIES=3
VIDEO_INFO_MAX_RETRIES=3
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_BASE_DELAY=1
UPSTREAM_DOWNLOAD_TIMEOUT_SECONDS=60

# Bounded concurrency and temporary spooling
EXTRACTION_CONCURRENCY=32
DOWNLOAD_CONCURRENCY=64
SLIDESHOW_CONCURRENCY=8
EXECUTOR_WORKERS=32
HTTP_MAX_CONNECTIONS=128
SPOOL_THRESHOLD_BYTES=16777216
DOWNLOAD_CHUNK_BYTES=65536

# Optional limits; zero disables the limit
MAX_VIDEO_DURATION=0
MAX_ASSET_BYTES=0

LOG_LEVEL=INFO
