# HTTP API: .env is loaded automatically; existing environment takes precedence.
TT_SCRAP_API_KEY=replace-with-at-least-16-characters
# HOST=0.0.0.0
# PORT=8000

# TikTok uses the native Android app API.
# App startup prepares 10 identities per proxy before opening the HTTP port.
# Required PostgreSQL database for the app identity pool.
DB_URL=postgresql://user:password@localhost:5432/database
# DB_SCHEMA=public
# Optional bootstrap file; saved DB proxies remain available without it.
# PROXY_FILE=proxies.txt
# PROXY_INCLUDE_HOST=false
# Send CDN bytes directly; app API and signing requests keep their identity proxy.
# PROXY_DATA_ONLY=false
# Optional TikTok sessionid cookie value (the value only, without "sessionid=").
# Used only after a content restriction; leave empty to disable account fallback.
# Kept in memory from the environment, never imported from cookies.txt or saved in DB.
# TIKTOK_SESSION_ID=
# TIKTOK_APP_TIMEOUT_SECONDS=180

# Metadata and opaque asset references stay in RAM.
# CACHE_TTL_SECONDS=600
# Total across asset references and all six response caches.
# CACHE_MAX_ENTRIES=10000
# TIKTOK_INFO_CACHE_TTL_SECONDS=60
# TIKTOK_RESOLUTION_CACHE_TTL_SECONDS=600

# Instagram RapidAPI; required by the readiness endpoint.
RAPIDAPI_KEY=replace-with-rapidapi-key
# INSTAGRAM_CONCURRENCY=4
# INSTAGRAM_MAX_ATTEMPTS=3
# INSTAGRAM_REQUEST_TIMEOUT_SECONDS=3
# INSTAGRAM_RETRY_DELAY_SECONDS=0.1

# Bounded network work and connection reuse.
# EXTRACTION_CONCURRENCY=32
# Each media transfer takes one slot; identity waits do not occupy slots.
# DOWNLOAD_CONCURRENCY=64
# HTTP_MAX_CONNECTIONS=128
# MAX_QUEUED_REQUESTS=1024
# Images prepared at once, admitted by estimated decoded size within the
# image memory budget; one image larger than the budget decodes alone.
# IMAGE_CONVERSION_WORKERS=32
# IMAGE_MEMORY_BUDGET_MB=1024
# URL_RESOLVE_MAX_RETRIES=3
# URL_RESOLVE_TIMEOUT_SECONDS=12
# VIDEO_INFO_MAX_RETRIES=3
# DOWNLOAD_MAX_RETRIES=3
# Media retries double this delay, with up to 10% jitter, within the download timeout.
# DOWNLOAD_RETRY_BASE_DELAY=1
# UPSTREAM_DOWNLOAD_TIMEOUT_SECONDS=60
# MAX_VIDEO_DURATION=0
# MAX_ASSET_BYTES=0
# Connections per media file for parallel byte ranges; 1 disables ranges.
# DOWNLOAD_PARALLEL_PARTS=4
# Media up to this size stays in RAM while the shared budget has room.
# MEDIA_MEMORY_MAX_MB=250
# MEDIA_MEMORY_BUDGET_MB=1024
# Larger media uses unlinked temporary files here.
# TEMP_DIR=/tmp

# Leave the token empty to disable Telegram delivery.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_PIPELINE_CONCURRENCY=32
# A single video, audio file, or document uploads while it downloads and holds
# its upload slot meanwhile; photos and albums upload after preparation.
# TELEGRAM_UPLOAD_CONCURRENCY=32
# Maximum media items prepared at once per delivery; thumbnails run alongside.
# TELEGRAM_PREPARATION_CONCURRENCY=32
# TELEGRAM_UPLOAD_TIMEOUT_SECONDS=600
# TELEGRAM_UPLOAD_MAX_MB=50
# TELEGRAM_THUMBNAIL_WAIT_SECONDS=1.5

# LOG_LEVEL=INFO
# Accepted levels: DEBUG, INFO, WARN, WARNING, ERROR, CRITICAL (case-insensitive).
# Optional Go heap budget; leave room for MEDIA_MEMORY_BUDGET_MB and
# IMAGE_MEMORY_BUDGET_MB, e.g. GOMEMLIMIT=3GiB.
